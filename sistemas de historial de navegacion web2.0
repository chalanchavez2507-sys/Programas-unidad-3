using System.Collections.Generic;
using System.Security.Cryptography.X509Certificates;
using System.Text.Json.Nodes;

namespace proyecto5_navegador
{
    public class pila
    {
        private nodo tope;

        private class nodo
        {
            public string pagina;
            public nodo siguiente;

            public nodo(string pagina)
            {
                pagina = pagina;
            }
        }

        public void push(string pagina)
        {
            nodo Nodo = new nodo(pagina);
            Nodo.siguiente = tope;
            tope = Nodo;
        }

        public string pop()
        {
            if (tope == null)
                return null;

            string pagina = tope.pagina;
            tope = tope.siguiente;

            return pagina;
        }
    }
}


namespace proyecto5_navegador
{
    internal class Program
    {
        static pila atras = new pila();
        static pila adelante = new pila();

        static string actual = "inicio";

        static void Main()
        {
            int opcion;

            do
            {
                Console.Clear();
                Console.WriteLine("===NAVEGADOR===");
                Console.WriteLine($"Pagina actual: {actual}");
                Console.WriteLine("1. visitar pagina");
                Console.WriteLine("2. atras");
                Console.WriteLine("3. adelante");
                Console.WriteLine("0. salir");
                Console.Write("opcion: ");

                opcion = int.Parse(Console.ReadLine());

                switch (opcion)
                {
                    case 1:
                        atras.push(actual);

                        Console.Write("nueva pagina: ");
                        actual = Console.ReadLine();

                        break;

                    case 2:
                        string anterior = atras.pop();

                        if (anterior != null)
                        {
                            adelante.push(actual);
                            actual = anterior;
                        }

                        break;

                    case 3:
                        string siguiente = adelante.pop();

                        if (siguiente != null)
                        {
                            atras.push(actual);
                            actual = siguiente;
                        }

                        break;
                }

            } while (opcion != 0);
            }
        }
    }




          





            

        